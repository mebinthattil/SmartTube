<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cinema_channel_pill"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_cinema_pill_button"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="14dp">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp">

        <ImageView
            android:id="@+id/cinema_channel_avatar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/cinema_channel_new_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_cinema_dot_blue"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/cinema_channel_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxWidth="140dp"
        android:singleLine="true"
        android:textColor="@color/cinema_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
