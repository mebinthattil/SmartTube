<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Silky Apple tvOS Activity & Dialog Transitions -->
    <style name="CinemaWindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/cinema_enter_scale_fade</item>
        <item name="android:activityOpenExitAnimation">@anim/cinema_exit_scale_fade</item>
        <item name="android:activityCloseEnterAnimation">@anim/cinema_enter_scale_fade</item>
        <item name="android:activityCloseExitAnimation">@anim/cinema_exit_scale_fade</item>
    </style>

    <!-- Translucent dialog sheet: never fade the underlying browse/video window (prevents flicker) -->
    <style name="CinemaDialogWindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/cinema_dialog_enter</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@anim/cinema_dialog_exit</item>
    </style>

    <!-- Apple TV Cinema Player Theme Overrides -->
    <style name="App.Theme.Leanback.Player" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="shelfBackground">@color/cinema_bg</item>
        <item name="cardDefaultBackground">@color/cinema_card_bg</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white</item>
        <item name="cardProgressStyle">?android:attr/progressBarStyleHorizontal</item>
        <item name="playbackProgressPrimaryColor">@color/cinema_progress_primary</item>
        <item name="playbackProgressSecondaryColor">@color/cinema_progress_secondary</item>
        <item name="playbackControlsIconHighlightColor">@color/cinema_progress_primary</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/cinema_progress_primary</item>
        <item name="itemsVerticalGridStyle">@style/GridViewStyle</item>
        <item name="rowHorizontalGridStyle">@style/RowViewStyle</item>
        <item name="android:windowAnimationStyle">@style/CinemaWindowAnimations</item>
        <item name="android:windowFullscreen">true</item>
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
        <item tools:targetApi="18" name="android:windowOverscan">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="App.Theme.DarkGrey.Player" parent="App.Theme.Leanback.Player">
        <item name="playbackProgressPrimaryColor">@color/cinema_progress_primary</item>
        <item name="playbackProgressSecondaryColor">@color/cinema_progress_secondary</item>
        <item name="playbackControlsIconHighlightColor">@color/cinema_progress_primary</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/cinema_progress_primary</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Dark</item>
    </style>

    <style name="App.Theme.Red.Player" parent="App.Theme.Leanback.Player">
        <item name="playbackProgressPrimaryColor">@color/cinema_progress_primary</item>
        <item name="playbackProgressSecondaryColor">@color/cinema_progress_secondary</item>
        <item name="playbackControlsIconHighlightColor">@color/cinema_progress_primary</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/cinema_progress_primary</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Red</item>
    </style>

    <style name="App.Theme.DarkGrey.OLED.Player" parent="App.Theme.DarkGrey.Player">
        <item name="cardSelectedBackground">@color/card_selected_background_white_grey</item>
    </style>

    <style name="App.Theme.Leanback.OLED.Player" parent="App.Theme.Leanback.Player">
        <item name="shelfBackground">@color/cinema_bg</item>
    </style>

    <!-- Unified Apple tvOS Floating Rounded Glass Sheet Theme (applies to ALL SmartTube Preferences themes) -->
    <style name="App.Theme.Leanback.Preferences.Base" parent="Theme.Leanback">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Leanback</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/cinema_emerald</item>
        <item name="android:colorPrimary" tools:targetApi="21">@android:color/transparent</item>
        <item name="defaultBrandColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/CinemaDialogWindowAnimations</item>
        <item name="android:windowFullscreen">true</item>
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
    </style>

    <style name="App.Theme.Leanback.Preferences" parent="App.Theme.Leanback.Preferences.Base" />

    <style name="App.Theme.DarkGrey.Preferences" parent="App.Theme.Leanback.Preferences.Base" />

    <style name="App.Theme.Red.Preferences" parent="App.Theme.Leanback.Preferences.Base" />

    <style name="App.Theme.Leanback.Blue.Preferences" parent="App.Theme.Leanback.Preferences.Base" />
</resources>
