<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV Liquid Glass circular secondary control button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:constantSize="true">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#4DFFFFFF" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
            <size android:width="33dp" android:height="33dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#66FFFFFF" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
            <size android:width="33dp" android:height="33dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#16FFFFFF" />
            <stroke android:width="0.75dp" android:color="#22FFFFFF" />
            <size android:width="33dp" android:height="33dp" />
        </shape>
    </item>
</selector>
